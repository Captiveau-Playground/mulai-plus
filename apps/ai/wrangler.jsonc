{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mulai-plus-ai",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat", "no_handle_cross_request_promise_resolution"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": { "DISCORD_WEBHOOK_URL": "",
    "OPENAI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "QUOTA_DAILY": "40"
  },
  "kv_namespaces": [
    { "binding": "AI_KV", "id": "434d1a4233b84809b26e7ccc31ceb1c3" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMIT_DO", "class_name": "RateLimitDO" }]
  },
  "migrations": [{ "tag": "kvdo-v1", "new_sqlite_classes": ["RateLimitDO"] }],
  "env": {
    "staging": {
      "workers_dev": false,
      "kv_namespaces": [
        { "binding": "AI_KV", "id": "434d1a4233b84809b26e7ccc31ceb1c3" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "RATE_LIMIT_DO", "class_name": "RateLimitDO" }]
      },
      "migrations": [{ "tag": "kvdo-v1", "new_sqlite_classes": ["RateLimitDO"] }],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "f98f19a5ab114162b2180cb41b0e5499"
        }
      ],
      "vars": {
        "CORS_ORIGIN": "https://staging.mulaiplus.id",
        "OPENAI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
        "QUOTA_DAILY": "40"
      }
    },
    "production": {
      "workers_dev": false,
      "kv_namespaces": [
        { "binding": "AI_KV", "id": "434d1a4233b84809b26e7ccc31ceb1c3" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "RATE_LIMIT_DO", "class_name": "RateLimitDO" }]
      },
      "migrations": [{ "tag": "kvdo-v1", "new_sqlite_classes": ["RateLimitDO"] }],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "86e1861682904ade889a0e9c7ce7ccc7"
        }
      ],
      "vars": {
        "CORS_ORIGIN": "https://mulaiplus.id",
        "OPENAI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8"
      }
    }
  }
}