{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mulai-plus-ai",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "OPENAI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8"
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "5d214aea95a842069ee2a0bba93222c4"
        }
      ],
      "routes": [
        {
          "pattern": "ai.staging.mulaiplus.id",
          "zone_name": "mulaiplus.id",
          "custom_domain": true
        }
      ],
      "vars": {
        "CORS_ORIGIN": "https://staging.mulaiplus.id",
        "OPENAI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8"
      }
    },
    "production": {
      "workers_dev": true,
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "42a918a410c84017afa795d9a58f6eb3"
        }
      ],
      "routes": [
        {
          "pattern": "ai.mulaiplus.id",
          "zone_name": "mulaiplus.id",
          "custom_domain": true
        }
      ],
      "vars": {
        "CORS_ORIGIN": "https://mulaiplus.id",
        "OPENAI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8"
      }
    }
  }
}